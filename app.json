{
  "expo": {
    "name": "Cuidary",
    "slug": "cuidary",
    "scheme": "cuidary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.cuidary.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "cl.cuidary.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F3F1EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cuidary usa tu ubicación para registrar el check-in GPS del turno."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cuidary necesita acceso a tus fotos para la foto de perfil o del paciente.",
          "cameraPermission": "Cuidary necesita acceso a la cámara para tomar la foto de perfil o del paciente."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F1EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68080d9f-b79b-410e-bd1c-c71757163a94"
      }
    },
    "owner": "jrodrigogonzalezv"
  }
}
